# elixir-mcp-collector configuration. Copy to .env (mode 0600) and fill in.
# .env is gitignored; NEVER commit real values — this repo is public.

# Clash Royale API token, IP-bound to this machine (canonical var name).
CR_API_TOKEN=
# This collector's row in the gateway table (uuid) and display name.
ELIXIR_MCP_GATEWAY_ID=
ELIXIR_MCP_GATEWAY_NAME=
# Per-collector IAM user credentials (scoped to the three queues + metrics).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Queue-name overrides (defaults match the stack; override for dev stacks).
#ELIXIR_MCP_QUEUE_LIVE=elixir-mcp-cr-requests-live
#ELIXIR_MCP_QUEUE_BULK=elixir-mcp-cr-requests-bulk
#ELIXIR_MCP_QUEUE_RESULTS=elixir-mcp-cr-results
