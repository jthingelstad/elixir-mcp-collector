# elixir-mcp-collector config. Copy to .env (chmod 600) and fill in.
# .env and every .env.* is gitignored; NEVER commit real values —
# this repo is public.

# Your Clash Royale API key, allowlisted to this machine's static IP
# (create it at https://developer.clashroyale.com). This is the ONE
# secret you supply.
CR_API_TOKEN=

# The collector token Elixir MCP shows you once, in Account > Collector
# after the owner provisions your collector. Starts with "emcg_".
ELIXIR_API_TOKEN=

# Optional: override the API base (defaults to production).
#ELIXIR_API_BASE=https://elixir.poapkings.com/api/collector
